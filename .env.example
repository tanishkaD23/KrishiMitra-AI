# KrishiMitra-AI Environment Variables Example
# Copy this file to .env and fill in your Supabase and optional API keys.
# Never commit your actual .env file or production secrets.

# ============================================================================
# 1. SUPABASE AUTHENTICATION CONFIGURATION (Required for Live Supabase Auth)
# ============================================================================
# Find these in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Frontend / Netlify Bundler aliases (automatically read if set in Netlify UI)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ============================================================================
# 2. APPLICATION & SESSION SECURITY
# ============================================================================
SECRET_KEY=replace-with-a-secure-random-hex-key
DEMO_DEFAULT_PASSWORD=Krishi@2026

# ============================================================================
# 3. AI & WEATHER SERVICES (Optional)
# ============================================================================
# Optional: OpenAI API key for KrishiSathi LLM synthesis (falls back to grounded RAG + All-India ML engine if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gnani.ai Voice AI (Prisma v3.0 Speech-to-Text & Timbre v2.5 Text-to-Speech)
# Get your API key from https://console.gnani.ai/
# Keeps your API key 100% secure on the Python backend; never exposed to browser or Netlify
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Optional: Google Gemini API key
GEMINI_API_KEY=

# Optional: OpenWeatherMap API key (Open-Meteo and NASA POWER work out-of-the-box without a key)
OPENWEATHER_API_KEY=

# Database path (defaults to krishimitra.db in data/)
KRISHIMITRA_DB_PATH=krishimitra.db
